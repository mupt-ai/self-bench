{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SelfBench",
  "colors": {
    "primary": "#0F9D76",
    "light": "#0F9D76",
    "dark": "#29C79B"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/how-it-works", "concepts/credentials", "concepts/self-hosting"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/account",
              "cli/build",
              "cli/review",
              "cli/environments",
              "cli/evaluate",
              "cli/inspect",
              "cli/publish",
              "cli/benchmarks-and-groups",
              "cli/operator"
            ]
          },
          {
            "group": "API",
            "pages": [
              "api/overview",
              "api/account",
              "api/build",
              "api/review",
              "api/environments",
              "api/evaluate",
              "api/inspect",
              "api/publish",
              "api/benchmarks-and-groups"
            ]
          },
          {
            "group": "Public Results",
            "pages": ["api/public"]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/cli", "destination": "/cli/overview" },
    { "source": "/cli/commands", "destination": "/cli/overview" },
    { "source": "/api", "destination": "/api/overview" },
    { "source": "/public-api", "destination": "/api/public" },
    { "source": "/guides/generate-tasks", "destination": "/concepts/how-it-works" },
    { "source": "/guides/author-scenarios", "destination": "/concepts/how-it-works" },
    { "source": "/guides/run-evaluations", "destination": "/concepts/credentials" },
    { "source": "/guides/inspect-results", "destination": "/api/inspect" },
    { "source": "/guides/publish-results", "destination": "/quickstart" },
    { "source": "/concepts/task-generation", "destination": "/concepts/how-it-works" },
    { "source": "/api-reference/overview", "destination": "/api/public" },
    { "source": "/api-reference/list-results", "destination": "/api/public" },
    { "source": "/api-reference/repository-results", "destination": "/api/public" },
    { "source": "/api-reference/workspace", "destination": "/api/account" },
    { "source": "/api-reference/api-keys", "destination": "/api/account" },
    { "source": "/api-reference/repositories", "destination": "/api/build" },
    { "source": "/api-reference/create-batch", "destination": "/api/build" },
    { "source": "/api-reference/create-scenario", "destination": "/api/build" },
    { "source": "/api-reference/tasks", "destination": "/api/review" },
    { "source": "/api-reference/list-tasks", "destination": "/api/review" },
    { "source": "/api-reference/create-comparison", "destination": "/api/evaluate" },
    { "source": "/api-reference/results", "destination": "/api/inspect" },
    { "source": "/api-reference/failure-analysis", "destination": "/api/inspect" },
    { "source": "/api-reference/create-benchmark", "destination": "/api/benchmarks-and-groups" },
    { "source": "/api-reference/publish-release", "destination": "/api/publish" }
  ]
}
