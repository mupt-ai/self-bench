{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SelfBench",
  "colors": {
    "primary": "#0F9D76",
    "light": "#0F9D76",
    "dark": "#29C79B"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/how-it-works", "concepts/credentials", "concepts/self-hosting"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": ["cli"]
          },
          {
            "group": "API",
            "pages": ["api", "public-api"]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/cli/overview", "destination": "/cli" },
    { "source": "/cli/commands", "destination": "/cli" },
    { "source": "/guides/generate-tasks", "destination": "/concepts/how-it-works" },
    { "source": "/guides/author-scenarios", "destination": "/concepts/how-it-works" },
    { "source": "/guides/run-evaluations", "destination": "/concepts/credentials" },
    { "source": "/guides/inspect-results", "destination": "/api" },
    { "source": "/guides/publish-results", "destination": "/quickstart" },
    { "source": "/concepts/task-generation", "destination": "/concepts/how-it-works" },
    { "source": "/api-reference/overview", "destination": "/public-api" },
    { "source": "/api-reference/list-results", "destination": "/public-api" },
    { "source": "/api-reference/repository-results", "destination": "/public-api" },
    { "source": "/api-reference/workspace", "destination": "/api" },
    { "source": "/api-reference/api-keys", "destination": "/api" },
    { "source": "/api-reference/repositories", "destination": "/api" },
    { "source": "/api-reference/create-batch", "destination": "/api" },
    { "source": "/api-reference/create-scenario", "destination": "/api" },
    { "source": "/api-reference/tasks", "destination": "/api" },
    { "source": "/api-reference/list-tasks", "destination": "/api" },
    { "source": "/api-reference/create-comparison", "destination": "/api" },
    { "source": "/api-reference/results", "destination": "/api" },
    { "source": "/api-reference/failure-analysis", "destination": "/api" },
    { "source": "/api-reference/create-benchmark", "destination": "/api" },
    { "source": "/api-reference/publish-release", "destination": "/api" }
  ]
}
