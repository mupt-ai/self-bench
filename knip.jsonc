{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/api/cli/bin.ts!",
    "src/api/main.ts!",
    "src/temporal/worker-main.ts!",
    // The one-time evaluation records migration, run by operators from the API image.
    "src/db/records-migration.ts!",
    // Temporal loads workflows and Pi loads extensions by path, not imports.
    "src/temporal/workflows.ts!",
    "src/evaluation/workflow.ts!",
    "src/harnesses/pi/extensions/{authoring,verifier,discovery}.ts!",
    "src/sandbox/programs/{author,check,verifier,compiler,task-operation,job}.ts!",
    "review/src/main.tsx!",
    "scripts/*.ts!",
    "tests/**/*.test.ts",
    "review/src/**/*.test.{ts,tsx}"
  ],
  "project": [
    "src/**/*.ts!",
    "review/src/**/*.{ts,tsx,css}!",
    "scripts/**/*.ts!",
    "tests/**/*.ts"
  ],
  "includeEntryExports": true,
  "ignoreIssues": {
    // These exports are registration interfaces for the external loaders.
    "src/temporal/workflows.ts": ["exports"],
    "src/evaluation/workflow.ts": ["exports"],
    "src/harnesses/pi/extensions/{authoring,verifier,discovery}.ts": ["exports"]
  },
  // Resolved through createRequire; the CLI is installed by the operator.
  "ignoreDependencies": ["@openai/codex"]
}
