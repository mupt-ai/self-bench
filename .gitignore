/node_modules
__pycache__/
.selfbench/
dist/
.env
.env.*
!.env.example
jobs/
# bun run video's default output.
/video-out/
.pi-subagents/

# Terraform state, saved plans, credentials, and environment-specific configuration.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
*.tfvars.json
# Each environment's settings are not secret, and are reviewed like code.
!/infra/terraform/environments/*/terraform.tfvars.json
**/backend.hcl
crash.log
crash.*.log
# Lockfiles and *.example files are intentionally tracked.
# Operator/runtime payload files; examples remain tracked.
/infra/**/*.env
# Generated OIDC credentials and operator-specific auth bootstrap inputs.
gha-creds-*.json
/infra/**/*.local.json
