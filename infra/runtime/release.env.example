# NONSECRET release coordinates. Reviewed per environment, never source this as a shell script.
SELFBENCH_ENVIRONMENT=dev
SELFBENCH_IMAGE=us-central1-docker.pkg.dev/YOUR-PROJECT/selfbench/selfbench@sha256:REVIEWED-DIGEST
SELFBENCH_SHARED_ENV_FILE=/etc/selfbench/shared.env
SELFBENCH_API_ENV_FILE=/etc/selfbench/api.env
SELFBENCH_WORKER_ENV_FILE=/etc/selfbench/worker.env
