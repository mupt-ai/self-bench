# Install Caddy separately using its official instructions; this is a host proxy, not an app container.
# Substitute the confirmed hostname. Configure/validate before opening the web firewall.
YOUR-ENVIRONMENT-DOMAIN {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
