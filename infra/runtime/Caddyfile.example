# Install Caddy separately using its official instructions; this is a host proxy, not an app container.
# Substitute the confirmed hostnames. Configure/validate before opening the web firewall:
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
# Both sites proxy to the same API; it serves the results site on its host
# (SELFBENCH_RESULTS_SITE_URL). Caddy's default X-Forwarded-For is the real client, which the
# public site's rate limit relies on: do not add trusted_proxies.
YOUR-ENVIRONMENT-DOMAIN {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

YOUR-RESULTS-SITE-DOMAIN {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Prod only: www redirects to the apex.
www.YOUR-RESULTS-SITE-DOMAIN {
    redir https://YOUR-RESULTS-SITE-DOMAIN{uri} permanent
}
