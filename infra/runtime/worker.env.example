# Secret Manager selfbench-worker-env. No model, sandbox, or GitHub user
# credentials belong here: generation loads the selected user's encrypted
# credentials server-side for the isolated sandbox.
# Use a distinct worker-only random value, NOT the API bearer credential.
SELFBENCH_API_TOKEN=LOAD-WORKER-ONLY-RANDOM-VALUE

# Optional: platform-owned model access for managed generation. Worker-only; never a user credential.
# SELFBENCH_MANAGED_OPENROUTER_API_KEY=LOAD-SECRET-OUT-OF-BAND
