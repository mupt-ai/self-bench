# Secret Manager selfbench-worker-env. Generation credentials; solver credentials are user-selected.
# API_HOST is shared; config parsing requires a token even though the worker serves no HTTP.
# Use a distinct worker-only random value, NOT the API bearer credential.
SELFBENCH_API_TOKEN=LOAD-WORKER-ONLY-RANDOM-VALUE
GH_TOKEN=LOAD-SCOPED-GITHUB-READ-TOKEN
OPENAI_API_KEY=LOAD-GENERATION-MODEL-KEY
MODAL_TOKEN_ID=LOAD-GENERATION-MODAL-TOKEN-ID
MODAL_TOKEN_SECRET=LOAD-GENERATION-MODAL-TOKEN-SECRET
