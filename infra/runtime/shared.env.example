# Secret Manager selfbench-shared-env. Loaded with node --env-file: KEY=value, no shell expansion.
# Copy separately for dev/prod; never reuse the production DB/key in ordinary dev.
SELFBENCH_API_HOST=0.0.0.0
SELFBENCH_API_PORT=8080
SELFBENCH_ARTIFACT_BACKEND=gcs
SELFBENCH_GCS_BUCKET=YOUR-ENVIRONMENT-ARTIFACT-BUCKET
SELFBENCH_GCS_PREFIX=selfbench
SELFBENCH_TEMPORAL_ADDRESS=YOUR-ENVIRONMENT-TEMPORAL-ENDPOINT
SELFBENCH_TEMPORAL_NAMESPACE=YOUR-ENVIRONMENT-NAMESPACE
SELFBENCH_TEMPORAL_API_KEY=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_TEMPORAL_TLS=true
SELFBENCH_TASK_QUEUE=selfbench-dev
SELFBENCH_GENERATION_TASK_QUEUE=selfbench-dev
# Combined worker: evaluation queue MUST equal SELFBENCH_TASK_QUEUE; use prod in prod.
SELFBENCH_EVAL_TASK_QUEUE=selfbench-dev
SELFBENCH_EXECUTION_BACKEND=modal
SELFBENCH_HARBOR_ENVIRONMENT=modal
SELFBENCH_DATABASE_URL=postgres://SCOPED-USER:SECRET@PRIVATE-DB:5432/selfbench?sslmode=require
SELFBENCH_EVAL_CREDENTIAL_KEY=LOAD-32-BYTE-HEX-SECRET-OUT-OF-BAND

# Sandbox jobs report back through the API. The API checks the grants the worker signs with
# this secret (32+ random characters); the worker also needs the public origin sandboxes call.
SELFBENCH_SANDBOX_SECRET=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_SANDBOX_CALLBACK_URL=https://YOUR-ENVIRONMENT-DOMAIN

# Optional: platform-owned model and sandbox access for managed generation. Setting these
# keys offers the matching managed options; the API also runs managed export sandboxes,
# so this file is where they belong.
# SELFBENCH_MANAGED_OPENROUTER_API_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_E2B_API_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_E2B_DOMAIN=
# Optional: a platform Modal token for managed Harbor verification. With it, managed runs verify
# on Modal (which runs task services); without it they verify on the managed E2B account.
# SELFBENCH_MANAGED_MODAL_TOKEN_ID=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_MODAL_TOKEN_SECRET=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_MODAL_ENVIRONMENT=selfbench-prod
# Optional billing policy shared by the API and worker. Defaults: one unit is
# $1e-7 (SELFBENCH_BILLING_UNIT_SCALE=10000000), pass-through provider rates
# (markup 0), and meter event name selfbench_managed_usage. The live Stripe
# price must match the unit scale.
# SELFBENCH_BILLING_UNIT_SCALE=10000000
# SELFBENCH_BILLING_MARKUP_BPS=0
# SELFBENCH_STRIPE_METER_EVENT_NAME=selfbench_managed_usage
