# Values shared by the API and workers. Values marked Secret Manager live in one secret each;
# the rest are Terraform inputs or derived by Terraform.
# Secret Manager: selfbench-database-url
SELFBENCH_DATABASE_URL=postgres://SCOPED-USER:SECRET@PRIVATE-DB:5432/selfbench?sslmode=require
# Secret Manager: selfbench-eval-credential-key
SELFBENCH_EVAL_CREDENTIAL_KEY=LOAD-32-BYTE-HEX-SECRET-OUT-OF-BAND
# Secret Manager: selfbench-sandbox-secret
SELFBENCH_SANDBOX_SECRET=LOAD-SECRET-OUT-OF-BAND
# Secret Manager: selfbench-temporal-api-key
SELFBENCH_TEMPORAL_API_KEY=LOAD-SECRET-OUT-OF-BAND
# Optional Secret Manager values, enabled together by managed_offering.
# SELFBENCH_MANAGED_OPENROUTER_API_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_E2B_API_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_MODAL_TOKEN_ID=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_MODAL_TOKEN_SECRET=LOAD-SECRET-OUT-OF-BAND

# Derived by Terraform.
SELFBENCH_API_HOST=0.0.0.0
SELFBENCH_API_PORT=8080
SELFBENCH_ARTIFACT_BACKEND=gcs
SELFBENCH_GCS_BUCKET=YOUR-ENVIRONMENT-ARTIFACT-BUCKET
SELFBENCH_GCS_PREFIX=selfbench
SELFBENCH_TEMPORAL_TLS=true
SELFBENCH_TASK_QUEUE=selfbench-dev
SELFBENCH_GENERATION_TASK_QUEUE=selfbench-dev
SELFBENCH_EVAL_TASK_QUEUE=selfbench-dev
SELFBENCH_EXECUTION_BACKEND=modal
SELFBENCH_HARBOR_ENVIRONMENT=modal
SELFBENCH_SANDBOX_CALLBACK_URL=https://YOUR-ENVIRONMENT-DOMAIN
# Derived from managed_offering: the one switch for managed models, sandboxes and billing.
# SELFBENCH_MANAGED_OFFERING=true
# SELFBENCH_MANAGED_MODAL_ENVIRONMENT=selfbench-dev
# Terraform inputs.
SELFBENCH_TEMPORAL_ADDRESS=YOUR-ENVIRONMENT-TEMPORAL-ENDPOINT
SELFBENCH_TEMPORAL_NAMESPACE=YOUR-ENVIRONMENT-NAMESPACE
# SENTRY_DSN=https://KEY@ORG.ingest.us.sentry.io/PROJECT
