# Secret Manager selfbench-shared-env. Docker env-file syntax: KEY=value, no shell expansion.
# Copy separately for dev/prod; never reuse the production DB/key in ordinary dev.
SELFBENCH_API_HOST=0.0.0.0
SELFBENCH_API_PORT=8080
SELFBENCH_ARTIFACT_BACKEND=gcs
SELFBENCH_GCS_BUCKET=YOUR-ENVIRONMENT-ARTIFACT-BUCKET
SELFBENCH_GCS_PREFIX=selfbench
SELFBENCH_TEMPORAL_ADDRESS=YOUR-ENVIRONMENT-TEMPORAL-ENDPOINT
SELFBENCH_TEMPORAL_NAMESPACE=YOUR-ENVIRONMENT-NAMESPACE
SELFBENCH_TEMPORAL_API_KEY=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_TEMPORAL_TLS=true
SELFBENCH_TASK_QUEUE=selfbench-dev
SELFBENCH_GENERATION_TASK_QUEUE=selfbench-dev
# Combined worker: evaluation queue MUST equal SELFBENCH_TASK_QUEUE; use prod in prod.
SELFBENCH_EVAL_TASK_QUEUE=selfbench-dev
SELFBENCH_EXECUTION_BACKEND=modal
SELFBENCH_HARBOR_ENVIRONMENT=modal
SELFBENCH_DATABASE_URL=postgres://SCOPED-USER:SECRET@PRIVATE-DB:5432/selfbench?sslmode=require
SELFBENCH_EVAL_CREDENTIAL_KEY=LOAD-32-BYTE-HEX-SECRET-OUT-OF-BAND

# Optional managed generation offer. When true, the site offers managed model access and/or
# managed (E2B) sandboxes; the matching platform keys must be provisioned (E2B key here, since
# the API runs managed exports; OpenRouter key on the worker).
# SELFBENCH_MANAGED_MODELS=true
# SELFBENCH_MANAGED_SANDBOX=true
# SELFBENCH_MANAGED_E2B_API_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_MANAGED_E2B_DOMAIN=
