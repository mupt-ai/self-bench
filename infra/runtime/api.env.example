# Secret Manager selfbench-api-env. API-only; never passed to the worker container.
GITHUB_OAUTH_CLIENT_ID=YOUR-ENVIRONMENT-OAUTH-APP
GITHUB_OAUTH_CLIENT_SECRET=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_PUBLIC_URL=https://YOUR-ENVIRONMENT-DOMAIN
SELFBENCH_SESSION_SECRET=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_API_TOKEN=LOAD-SECRET-OUT-OF-BAND
# Optional Stripe metered billing: all three together or none. Only the API holds
# Stripe access; generation and export never call Stripe. The webhook secret is
# from a Dashboard endpoint at this origin's /api/stripe/webhook.
# SELFBENCH_STRIPE_SECRET_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_STRIPE_PRICE_ID=price_YOUR-METERED-PRICE
# SELFBENCH_STRIPE_WEBHOOK_SECRET=LOAD-SECRET-OUT-OF-BAND
