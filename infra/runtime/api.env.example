# Secret Manager selfbench-api-env. Read only by the Cloud Run API service, never the worker.
GITHUB_OAUTH_CLIENT_ID=YOUR-ENVIRONMENT-OAUTH-APP
GITHUB_OAUTH_CLIENT_SECRET=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_PUBLIC_URL=https://YOUR-ENVIRONMENT-DOMAIN
# The public results site, served by this API on its own host (prod: https://selfbench.dev).
SELFBENCH_RESULTS_SITE_URL=https://YOUR-RESULTS-SITE-DOMAIN
# Let search engines index it: true in prod only; unset sends noindex.
# SELFBENCH_RESULTS_SITE_INDEX=true
SELFBENCH_SESSION_SECRET=LOAD-SECRET-OUT-OF-BAND
SELFBENCH_API_TOKEN=LOAD-SECRET-OUT-OF-BAND
# Optional: Sentry for the app and selfbench.dev in the browser (a browser project's DSN), and
# PostHog for page views there and the API's product events. Both are public by design and
# reach the pages at runtime, so one image serves every environment.
# SENTRY_BROWSER_DSN=https://KEY@ORG.ingest.us.sentry.io/PROJECT
# POSTHOG_API_KEY=phc_YOUR-PROJECT-KEY
# POSTHOG_HOST=https://us.i.posthog.com
# Optional: limit sign-in to active members of these GitHub organizations (comma-separated,
# case-insensitive). Unset keeps sign-in open to everyone.
# SELFBENCH_ALLOWED_GITHUB_ORGS=mupt-ai
# Optional Stripe metered billing: all three together or none. Only the API holds
# Stripe access; generation and export never call Stripe. The webhook secret is
# from a Dashboard endpoint at this origin's /api/stripe/webhook.
# SELFBENCH_STRIPE_SECRET_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_STRIPE_PRICE_ID=price_YOUR-METERED-PRICE
# SELFBENCH_STRIPE_WEBHOOK_SECRET=LOAD-SECRET-OUT-OF-BAND
# Optional, disabled by default: immutable GitHub org ID allowed to grant invoice credits.
# SELFBENCH_BILLING_CREDIT_ADMIN_ORG_ID=
