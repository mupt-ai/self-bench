# API-only runtime inventory. Values marked Secret Manager live in one secret each; the rest are
# Terraform inputs or derived by Terraform.
# Secret Manager: selfbench-github-oauth-client-secret
GITHUB_OAUTH_CLIENT_SECRET=LOAD-SECRET-OUT-OF-BAND
# Secret Manager: selfbench-session-secret
SELFBENCH_SESSION_SECRET=LOAD-SECRET-OUT-OF-BAND
# Secret Manager: selfbench-api-token
SELFBENCH_API_TOKEN=LOAD-SECRET-OUT-OF-BAND
# Optional Secret Manager values, required together when managed_offering is true and
# stripe_price_id is set.
# SELFBENCH_STRIPE_SECRET_KEY=LOAD-SECRET-OUT-OF-BAND
# SELFBENCH_STRIPE_WEBHOOK_SECRET=LOAD-SECRET-OUT-OF-BAND
# Optional Secret Manager value, required when task_canary is true: SelfBench's canary GUID,
# which the tasks selfbench.dev publishes carry.
# SELFBENCH_TASK_CANARY=LOAD-SECRET-OUT-OF-BAND

# Terraform input: github_oauth_client_id
GITHUB_OAUTH_CLIENT_ID=YOUR-ENVIRONMENT-OAUTH-APP
# Deploy inputs: SELFBENCH_PUBLIC_URL and SELFBENCH_RESULTS_SITE_URL GitHub variables
SELFBENCH_PUBLIC_URL=https://YOUR-ENVIRONMENT-DOMAIN
SELFBENCH_RESULTS_SITE_URL=https://YOUR-RESULTS-SITE-DOMAIN
# Derived: true in prod only.
# SELFBENCH_RESULTS_SITE_INDEX=true
# Optional Terraform inputs: sentry_browser_dsn, posthog_api_key, and with managed_offering,
# stripe_price_id.
# SENTRY_BROWSER_DSN=https://KEY@ORG.ingest.us.sentry.io/PROJECT
# POSTHOG_API_KEY=phc_YOUR-PROJECT-KEY
# SELFBENCH_STRIPE_PRICE_ID=price_YOUR-METERED-PRICE
