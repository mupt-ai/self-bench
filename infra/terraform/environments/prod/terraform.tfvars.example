# Names, region and sizing are proposals, NOT existing resources.
project_id = "selfbench-prod-YOUR-SUFFIX"
region     = "us-central1"
api_domains = ["app.selfbench.dev", "selfbench.dev"]
redirect_domains = { "www.selfbench.dev" = "selfbench.dev" }
# Proposed: ZONAL shared-core dev; REGIONAL dedicated-core prod. Review cost first.
create_cloud_sql = true
cloud_sql_tier = "db-custom-1-3840"
cloud_sql_availability_type = "ZONAL"
cloud_sql_retained_backups = 7
activity_concurrency = 8
# image and secret_versions are supplied by the deploy workflow.
