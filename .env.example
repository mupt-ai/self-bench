# Copy to .env; docker compose reads it. Every value is optional.
# This file is safe to share between worktrees: Compose names the project after
# the checkout directory and publishes ephemeral host ports.

# selfbench.dev sign-in. Leave GITHUB_OAUTH_CLIENT_ID unset to keep the bearer-token Ledger
# instead of the signed-in site. The OAuth app must list each stack's callback,
# <public URL>/auth/github/callback. Set SELFBENCH_PUBLIC_URL to the tunnel or
# reverse-proxy origin before `up`, not the ephemeral compose host port.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 32+ characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SELFBENCH_SESSION_SECRET=

# Solver evaluations: 32-byte lowercase hex key that encrypts saved model credentials.
# openssl rand -hex 32
SELFBENCH_EVAL_CREDENTIAL_KEY=

# GitHub reads for CLI batches and workers. Site generation instead uses the submitter's
# OAuth token per run; hosted workers should not have a GH_TOKEN of their own.
GH_TOKEN=

# Managed generation: setting a platform key offers the matching managed option in the
# Generate Batch panel (OpenRouter key -> managed models, E2B key -> managed sandboxes);
# usage is metered per run. This is also how local stacks get model access — there is no
# OPENAI_API_KEY compose passthrough.
SELFBENCH_MANAGED_OPENROUTER_API_KEY=
SELFBENCH_MANAGED_E2B_API_KEY=

# Stripe metered billing for managed usage. Leave all three unset to keep billing
# disabled (managed runs stay available). Setting only some of them is an error.
# The meter event name and integer unit policy are shared with the worker.
# SELFBENCH_STRIPE_SECRET_KEY=
# SELFBENCH_STRIPE_WEBHOOK_SECRET=
# SELFBENCH_STRIPE_PRICE_ID=
# SELFBENCH_STRIPE_METER_EVENT_NAME=selfbench_managed_usage
# SELFBENCH_BILLING_UNIT_SCALE=10000000
# SELFBENCH_BILLING_MARKUP_BPS=0

# Generation / Harbor pairing. Unset, Compose defaults to docker generation.
# SELFBENCH_EXECUTION_BACKEND=docker
# SELFBENCH_HARBOR_ENVIRONMENT=docker
# SELFBENCH_MODAL_CONFIG_PATH=/absolute/path/to/.modal.toml
# SELFBENCH_PUBLIC_URL=
# SELFBENCH_DOCKER_IMAGE=selfbench-sandbox:local
