# Copy to .env; docker compose and `self-bench up` read it. Every value is optional.
# This file is safe to share between worktrees: nothing in it is per checkout. `self-bench up`
# derives the Compose project, host ports, and image tags from the checkout directory.

# selfbench.dev sign-in. Leave GITHUB_OAUTH_CLIENT_ID unset to keep the bearer-token Ledger
# instead of the signed-in site. The OAuth app must list each stack's callback,
# <public URL>/auth/github/callback; `self-bench up` prints it.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 32+ characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SELFBENCH_SESSION_SECRET=
# Hostname browsers open. Loopback (the default) binds 127.0.0.1 and lets one OAuth callback,
# http://127.0.0.1/auth/github/callback, cover every port. Any other hostname (e.g. a tailnet
# name) binds 0.0.0.0 and needs one callback per stack, ports included.
SELFBENCH_SITE_HOSTNAME=

# Many worktrees behind one shared door: each stack answers at http://<project>.<domain>, served
# by the machine-wide proxy from `self-bench proxy up` (Caddy on SELFBENCH_DEV_PROXY_PORT, DNS for
# the whole domain). Split DNS for the domain must point at SELFBENCH_DEV_PROXY_IP (e.g. this
# machine's tailnet IP), and one wildcard-enabled GitHub OAuth callback covers every stack:
#   http://<domain>[:SELFBENCH_DEV_PROXY_PORT]/auth/github/callback
# OrbStack keeps port 80 for itself, so port 8000 is the usual local setting.
SELFBENCH_DEV_DOMAIN=
SELFBENCH_DEV_PROXY_IP=
SELFBENCH_DEV_PROXY_PORT=8000

# Solver evaluations: 32-byte lowercase hex key that encrypts saved model credentials.
# openssl rand -hex 32
SELFBENCH_EVAL_CREDENTIAL_KEY=

# Worker credentials.
GH_TOKEN=
OPENAI_API_KEY=

# Per-stack overrides. Do not put these in a .env shared across worktrees; export them in the
# shell instead. Unset, `self-bench up` derives them (the canonical self-bench checkout keeps
# selfbench / 8080 / 7233) and plain `docker compose up` uses the defaults in compose.yaml.
# COMPOSE_PROJECT_NAME=
# SELFBENCH_SITE_PORT=
# SELFBENCH_SITE_BIND=
# SELFBENCH_TEMPORAL_PORT=
# SELFBENCH_PUBLIC_URL=
# SELFBENCH_IMAGE=
# SELFBENCH_DOCKER_IMAGE=
