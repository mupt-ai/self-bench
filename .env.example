# Optional signed-in site configuration for Docker Compose.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# At least 32 characters; signs sessions and encrypts GitHub tokens.
SELFBENCH_SESSION_SECRET=
SELFBENCH_PUBLIC_URL=http://127.0.0.1:8080

# 32-byte hex key for encrypted model credentials: openssl rand -hex 32
SELFBENCH_EVAL_CREDENTIAL_KEY=

# Worker credentials.
GH_TOKEN=
OPENAI_API_KEY=
